{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "typecheck": {
      "inputs": [
        "src/**",
        "seeds/**",
        "*.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        "seeds/**",
        "*.ts",
        "$TURBO_ROOT$/eslint.config.mjs",
        "package.json"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "$TURBO_ROOT$/supabase/migrations/**",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local",
        "package.json"
      ]
    }
  }
}
