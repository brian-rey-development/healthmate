---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { absoluteUrl } from '../data/url';
---

<header class="container-page flex min-h-19 items-center justify-between">
  <a
    class="inline-flex items-center gap-2.5 font-display text-lg font-bold no-underline"
    href={absoluteUrl('', Astro.site)}
    aria-label={`${SITE.name} home`}
  >
    <Logo />
    {SITE.name}
  </a>
  <a class="inline-flex min-h-11 items-center text-sm font-semibold text-ink/80 no-underline hover:text-ink" href={SITE.repoUrl}>GitHub</a>
</header>
