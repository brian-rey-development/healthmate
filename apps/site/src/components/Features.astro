---
import { Image } from 'astro:assets';
import { FEATURES } from '../data/site';
---

<section class="container-page pb-16 md:pb-26" aria-labelledby="features-title">
  <div class="border-t border-ink/10 pt-12 md:pt-18">
    <h2 id="features-title" class="max-w-[22ch] text-3xl leading-tight font-bold tracking-tight md:text-4xl">
      One record for everything about your health.
    </h2>
    <ul class="mt-10 grid gap-x-10 gap-y-12 sm:grid-cols-2 md:mt-14 lg:grid-cols-3">
      {
        FEATURES.map(({ title, body, illustration }) => (
          <li class="grid content-start justify-items-start gap-2.5">
            <Image src={illustration} alt="" width={240} class="mb-2 h-32 w-auto" />
            <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
            <p class="text-ink/80">{body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
