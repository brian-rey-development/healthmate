---
import Base from '../layouts/Base.astro';
import { absoluteUrl } from '../data/url';
---

<Base>
  <main class="container-page grid justify-items-start gap-6 py-28" aria-labelledby="not-found-title">
    <h1 id="not-found-title" class="text-5xl leading-tight font-bold tracking-tight">Page not found.</h1>
    <p class="text-lg text-ink/80">This page does not exist or has moved.</p>
    <a
      class="inline-flex min-h-13 items-center rounded-full bg-primary px-6.5 font-bold text-surface no-underline transition-colors hover:bg-ink"
      href={absoluteUrl('', Astro.site)}
    >
      Back to the home page
    </a>
  </main>
</Base>
