---
import '../styles/global.css';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import { SITE } from '../data/site';
import { absoluteUrl } from '../data/url';

const canonical = new URL(Astro.url.pathname, Astro.site);
const site = Astro.site;
const ogImage = absoluteUrl('og.png', site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE.name, url: canonical.href, description: SITE.description },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Web, Telegram',
      description: SITE.description,
      url: canonical.href,
      author: { '@type': 'Person', name: SITE.author },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <link rel="preload" as="font" type="font/woff2" href={bricolageLatin} crossorigin />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#f5f8f7" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={absoluteUrl('favicon.svg', site)} type="image/svg+xml" />
    <link rel="sitemap" href={absoluteUrl('sitemap-index.xml', site)} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={absoluteUrl('llms.txt', site)} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}. ${SITE.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
