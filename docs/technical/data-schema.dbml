// HealthMate data schema, v0.1. This file is the living design of the data model. It changes with each release.
// The Drizzle files packages/database/src/**/*.table.ts and *.view.ts are the source of truth for code.
// Update this file in the same change as the schema.

Project healthmate {
  database_type: 'PostgreSQL'
  Note: 'Every table has RLS on. All data belongs to one user. Postgres 17.'
}

Enum kind {
  note
  symptom
}

Enum date_precision {
  day
  month
  year
}

Enum channel {
  telegram
  web
}

Enum message_role {
  user
  assistant
  tool
}

Enum tool_call_status {
  pending
  confirmed
  discarded
  expired
  done
}

Enum tool_call_maker {
  agent
  person
}

Table users {
  id uuid [pk, note: 'Same id as auth.users. On delete restrict.']
  display_name text [not null]
  created_at timestamptz [not null]

  Note: 'One row for each person who uses HealthMate.'
}

Table subjects {
  id uuid [pk]
  user_id uuid [ref: > users.id, note: 'Null for a seed row that all users see.']
  kind kind [not null, note: 'Never note. A CHECK enforces this.']
  name text [not null, note: 'For example "headache".']
  created_at timestamptz [not null]

  indexes {
    (id, kind) [unique, note: 'Target of the composite foreign key from entries.']
    (kind, name) [unique, note: 'On lower(name), WHERE user_id IS NULL. One seed name for each kind.']
    (user_id, kind, name) [unique, note: 'On lower(name), WHERE user_id IS NOT NULL. One private name for each person and kind.']
    name [type: gin, note: 'pg_trgm, for search_subjects. Serves % and ilike.']
  }

  Note: 'The standard names that a person tracks. A person reads seed rows and their own rows, and writes only their own rows. The repository applies this rule. RLS has no policy yet.'
}

Table entries {
  id uuid [pk, note: 'Stays the same through all corrections.']
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [note: 'Null for a note, and only for a note. A CHECK enforces this.']
  tool_call_id text [not null, unique, ref: > tool_calls.id, note: 'The tool call that made the current version.']
  version integer [not null, default: 1, note: 'Each correction adds 1. An update must match the version that the agent read. A CHECK keeps it at 1 or more. An update that does not add 1 fails on the entry_history primary key.']
  kind kind [not null]
  value jsonb [not null, note: 'Checked by the zod schema of the kind. Symptom is {"severity": 0-10}. Note is {}.']
  original_words text [not null]
  start_date date [not null]
  start_precision date_precision [not null]
  start_time time [note: 'Only with day precision. A CHECK enforces this.']
  end_date date [note: 'Null while the entry is open. Not before start_date.']
  end_time time [note: 'Only with an end_date.']
  time_zone text [not null, note: 'IANA zone, for example Europe/Madrid.']
  created_at timestamptz [not null, note: 'Time of the first confirm.']
  updated_at timestamptz [not null, note: 'Time of the last correction.']

  indexes {
    (user_id, start_date) [note: 'Timeline.']
    (user_id, subject_id, start_date) [note: 'All entries of one subject.']
  }

  Note: 'The current data of each confirmed health fact. A trigger copies each insert and update into entry_history. No delete. ADR-003 keeps writers outside core out of the database. The trigger is an exception, because it makes no domain decision and only copies a row. The database does not check that tool_call_id and subject_id belong to user_id. The use case in core checks this.'
}

Table entry_history {
  entry_id uuid [not null, ref: > entries.id]
  version integer [not null]
  tool_call_id text [not null, unique, ref: > tool_calls.id, note: 'One tool call makes at most one version.']
  user_id uuid [not null]
  subject_id uuid
  kind kind [not null]
  value jsonb [not null]
  original_words text [not null]
  start_date date [not null]
  start_precision date_precision [not null]
  start_time time
  end_date date
  end_time time
  time_zone text [not null]
  recorded_at timestamptz [not null, note: 'Copy of entries.updated_at, so the time comes from the app clock.']

  indexes {
    (entry_id, version) [pk]
  }

  Note: 'A copy of each version of each entry, the current version included. Insert only. Only the trigger writes here.'
}

Table conversations {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  channel channel [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, created_at)
  }

  Note: 'One session with the agent in one channel.'
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null, ref: > conversations.id]
  role message_role [not null]
  content jsonb [not null, note: 'List of blocks. A block is text, tool_use or tool_result.']
  transcript text [note: 'Raw text of a voice message. The audio is deleted after transcription.']
  model text [note: 'For an assistant message.']
  prompt_version text [note: 'For an assistant message.']
  created_at timestamptz [not null]

  indexes {
    (conversation_id, created_at)
  }

  Note: 'Each message in a conversation, in the shape of the LLM APIs. Insert only.'
}

Table tool_calls {
  id text [pk, note: 'The tool_use id from the model, or a new id from the web form.']
  user_id uuid [not null, ref: > users.id, note: 'The owner. A web form call has no message, so ownership cannot come from the conversation.']
  message_id uuid [ref: > messages.id, note: 'The assistant message. Null for the web form. A CHECK makes it set when made_by is agent, and only then.']
  name text [not null, note: 'For example propose_entry, propose_correction, search_subjects.']
  input jsonb [not null, note: 'Checked by the zod schema of the tool.']
  status tool_call_status [not null, note: 'Confirm changes pending to confirmed only once. A read is done at once.']
  made_by tool_call_maker [not null]
  decided_at timestamptz [note: 'Null only while pending. A CHECK enforces this.']
  created_at timestamptz [not null, note: 'The age of a pending proposal comes from this value.']

  indexes {
    message_id
    (user_id, created_at) [note: 'WHERE status = pending. Open proposals of one person, and the expiry sweep.']
  }

  Note: 'Each tool call from the agent or the web form. A proposal is a pending tool call.'
}

Table citations {
  message_id uuid [not null, ref: > messages.id]
  entry_id uuid [not null]
  version integer [not null]

  indexes {
    (message_id, entry_id, version) [pk]
    (entry_id, version) [note: 'For the foreign key to entry_history.']
  }

  Note: 'Link from an answer to each exact entry version that it used. The agent checks in code that each cited entry came from a tool result of the same turn.'
}

Ref: entries.(subject_id, kind) > subjects.(id, kind)
Ref: citations.(entry_id, version) > entry_history.(entry_id, version)

// View timeline_entries (DBML has no view syntax). Each entry with subjects.name as subject_name.
// security_invoker = true, so the view applies the RLS of its tables. No ORDER BY, because timeline order is ADR-004.
