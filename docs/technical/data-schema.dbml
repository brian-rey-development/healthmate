// HealthMate data schema, v0.1. This file is the living design of the data model. It changes with each release.
// The Drizzle files packages/database/src/**/*.table.ts are the source of truth for code.
// Update this file in the same change as the schema.

Project healthmate {
  database_type: 'PostgreSQL'
  Note: 'Every table has RLS on. All data belongs to one user. Postgres 17.'
}

Enum kind {
  note
  symptom
}

Enum date_precision {
  day
  month
  year
}

Enum channel {
  telegram
  web
}

Enum message_role {
  user
  assistant
  tool
}

Table users {
  id uuid [pk, note: 'Same id as auth.users. On delete restrict.']
  display_name text [not null]
  created_at timestamptz [not null]

  Note: 'One row for each person who uses HealthMate.'
}

Table subjects {
  id uuid [pk]
  user_id uuid [ref: > users.id, note: 'Null for a seed row that all users see.']
  kind kind [not null, note: 'Never note. A CHECK enforces this.']
  name text [not null, note: 'For example "headache".']
  created_at timestamptz [not null]

  indexes {
    (id, kind) [unique, note: 'Target of the composite foreign key from entries.']
    (kind, name) [unique, note: 'On lower(name), WHERE user_id IS NULL. One seed name for each kind.']
    (user_id, kind, name) [unique, note: 'On lower(name), WHERE user_id IS NOT NULL. One private name for each person and kind.']
    name [type: gin, note: 'pg_trgm, for search_subjects. Serves % and ilike.']
  }

  Note: 'The standard names that a person tracks. A person reads seed rows and their own rows, and writes only their own rows. The repository applies this rule. RLS has no policy yet.'
}

Table entries {
  id uuid [pk, note: 'Stays the same through all corrections.']
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [note: 'Null for a note, and only for a note. A CHECK enforces this.']
  version integer [not null, note: 'No default, because core sets it. Each correction adds 1 in SQL, and the update only matches the stored version minus 1. A CHECK keeps it at 1 or more.']
  kind kind [not null]
  value jsonb [not null, note: 'Checked by the zod schema of the kind. Symptom is {"severity": 0-10}. Note is {}.']
  original_words text [not null]
  start_date date [not null]
  start_precision date_precision [not null]
  start_time time [note: 'Only with day precision. A CHECK enforces this.']
  end_date date [note: 'Null while the entry is open. Not before start_date.']
  end_time time [note: 'Only with an end_date.']
  time_zone text [not null, note: 'IANA zone, for example Europe/Madrid.']
  created_at timestamptz [not null, note: 'Time of the first confirm.']
  updated_at timestamptz [not null, note: 'Time of the last correction.']
  source_message_id uuid [not null, ref: > messages.id, note: 'The message that made the current version. For the agent, the assistant message with the proposal. For the web form, the user message of the submit.']
  source_tool_use_id text [note: 'The id of the propose tool_use block in that message. Null for the web form.']

  indexes {
    (source_message_id, source_tool_use_id) [unique, note: 'NULLS NOT DISTINCT. A second confirm of the same proposal inserts nothing.']
    (user_id, start_date, id) [name: 'entries_user_start_id_idx', note: 'timeline.listStartingBetween. start_date is DESC in the index. Newest start date first, then id.']
  }

  Note: 'The current data of each confirmed health fact. A trigger copies each insert and update into entry_history. No delete. ADR-003 keeps writers outside core out of the database. The trigger is an exception, because it makes no domain decision and only copies a row. The database does not check that the source message and subject_id belong to user_id. The use case in core checks this.'
}

Table entry_history {
  entry_id uuid [not null, ref: > entries.id]
  version integer [not null]
  user_id uuid [not null]
  subject_id uuid
  kind kind [not null]
  value jsonb [not null]
  original_words text [not null]
  start_date date [not null]
  start_precision date_precision [not null]
  start_time time
  end_date date
  end_time time
  time_zone text [not null]
  source_message_id uuid [not null, ref: > messages.id]
  source_tool_use_id text
  recorded_at timestamptz [not null, note: 'Copy of entries.updated_at, so the time comes from the app clock.']

  indexes {
    (entry_id, version) [pk]
    (source_message_id, source_tool_use_id) [unique, note: 'NULLS NOT DISTINCT. One proposal or one form submit makes at most one version.']
  }

  Note: 'A copy of each version of each entry, the current version included. Insert only. Only the trigger writes here. The trigger function is SECURITY DEFINER, and anon and authenticated cannot run it. The timeline is a join of entries and subjects in the repository, and the database has no view.'
}

Table conversations {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  channel channel [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, channel, created_at) [note: 'conversations.findLatest.']
  }

  Note: 'One session with the agent in one channel.'
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null, ref: > conversations.id]
  role message_role [not null]
  content jsonb [not null, note: 'List of blocks in the shape of the model API. A block is text, thinking, redacted_thinking, tool_use or tool_result.']
  transcript text [note: 'Raw text of a voice message. The audio is deleted after transcription.']
  model text [note: 'For an assistant message.']
  prompt_version text [note: 'For an assistant message.']
  created_at timestamptz [not null]

  indexes {
    (conversation_id, created_at, id) [note: 'messages.findLatest and messages.listLatest. Ordered by created_at, then id.']
  }

  Note: 'Each message in a conversation. Insert only. Messages are the audit trail of the agent, with its reasoning, its tool calls and their results. A proposal is a tool_use block, for example propose_entry, in an assistant message. The person confirms or discards it with a tool_result in the next user message. The model API answers every tool_use in the next turn, so only the last message of a conversation can hold an open proposal. Expiry comes from created_at and is never stored. A web form submit is a user message in a web conversation.'
}

Table citations {
  message_id uuid [not null, ref: > messages.id]
  entry_id uuid [not null]
  version integer [not null]

  indexes {
    (message_id, entry_id, version) [pk, note: 'citations.listForMessage and the conflict target of insertMany.']
  }

  Note: 'Link from an answer to each exact entry version that it used. The agent checks in code that each cited entry came from a tool result of the same turn.'
}

Ref: entries.(subject_id, kind) > subjects.(id, kind)
Ref: citations.(entry_id, version) > entry_history.(entry_id, version)
