# Optional overrides. Copy to .env, which loads before .env.local and wins.
# `pnpm stack:up` writes .env.local from the running stack, so a fresh clone needs no .env.
#
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# SUPABASE_URL=http://127.0.0.1:56321
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=   (server-only, never ship to apps/mobile or apps/telegram)
